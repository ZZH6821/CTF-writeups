# Curve parameters
p = 2 ^ 256 - 2 ^ 32 - 977
a = 0
b = 7
xG = 0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798
yG = 0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8
n = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141
msg = b"message_to_sign"
h = bytes_to_long(sha256(msg).digest())
t = 18
# Prepare a_i and b_i
a_list = []
b_list = []
for i in range(t):
    s_inv = inverse_mod(S[i], n)
    a_i = (s_inv * R[i]) % n
    b_i = (s_inv * h) % n
    a_list.append(a_i)
    b_list.append(b_i)
# Construct the lattice
C1 = 2 ^ (256 - 240)  # Since k is 240-bit and n is 256-bit
C2 = 2 ^ 256  # Balance for sk (256-bit)
M = matrix(ZZ, t + 2, t + 2)
for i in range(t):
    M[i, i] = n * C1
    M[-2, i] = a_list[i] * C1
    M[-1, i] = b_list[i] * C1
M[-2, -2] = 1
M[-1, -1] = C2
# Perform LLL reduction
ML = M.LLL()
# Find the target vector
for row in ML:
    if abs(row[-1]) == C2:
        # The second last element is sk
        sk = abs(row[-2])
        print("Found sk:", sk)
        print("Flag:", long_to_bytes(sk))
        break
else:
    print("Failed to find sk in the reduced basis.")
